# Секреты и инфраструктура. После изменения .env пересоздайте контейнеры.
# Биржа, рынок и режим исполнения: config/trading.json → execution или панель.
# Провайдеры ИИ, независимые base_url/модели: config/base.json → ai или вкладка «ИИ».
# .env не выбирает торговый режим. Без явных настроек используется read_only.
# Не публикуйте рабочий .env; рекомендуемые права: chmod 600 .env.

# ИИ: задайте ключи только тех провайдеров, которыми пользуетесь.
# OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Официальный DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# LM Studio: необязательный API-токен, если на локальном сервере включена авторизация.
# Из Podman адрес сервера обычно http://host.containers.internal:1234/v1.
# Сам base_url задаётся в профиле LM Studio в панели, не в .env.
LM_STUDIO_API_KEY=

# BingX: API-ключ и секрет. DEMO явно включается в execution и использует VST.
BINGX_API_KEY=
BINGX_SECRET_KEY=

# MEXC Spot / USDT-M Perpetual: у биржи нет API sandbox.
# DEMO нормализуется в read_only; LIVE нельзя включить переменной окружения.
MEXC_API_KEY=
MEXC_SECRET_KEY=

# Telegram / Web-панель
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
# Telegram user ID с доступом к панели и боту, через запятую.
TELEGRAM_ALLOWED_IDS=
# HTTPS-адрес Mini App. Пустое значение — для настроенного автоматического туннеля.
TELEGRAM_PANEL_URL=
PANEL_PORT=8080

# Необязательный SSH-туннель к VPS для HTTPS-доступа Mini App.
# VPS_HOST включает автоматический туннель; не храните SSH private key в .env.
VPS_HOST=
VPS_USER=root
VPS_PORT=9080
