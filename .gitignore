# Рабочие данные целиком локальные; в Git остаётся только правило исключения.
/data/*
!/data/.gitignore
/config/*.lock
/config/*.tmp
/.config/

# Generated charts
charts/

# API Keys and Credentials
*.key
credentials.json
secrets.json

# Python bytecode
*.pyc
*.pyo
*.pyd

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Coverage reports
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/

# Build artifacts
build/
dist/
node_modules/
*.egg-info/

# Local binaries
ngrok
